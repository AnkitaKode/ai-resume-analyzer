# ==============================================================================
# AI Resume Analyzer + RAG - Backend Environment Variables Template
# Copy this file to .env and configure values before starting the application.
# Never commit real credentials or .env to version control.
# ==============================================================================

# Server & Profile
# Use 'dev' for local offline development (Ollama)
# Use 'prod' for deployed cloud environments (Groq)
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Database Configuration (PostgreSQL + pgvector)
DATABASE_URL=jdbc:postgresql://localhost:5432/resumeai
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your_postgres_password_here

# Frontend Application URL & CORS
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Security & JWT Configuration
# Generate a secure 256-bit (32+ bytes) random secret key for production
JWT_SECRET=ai-resume-analyzer-secure-jwt-signing-key-minimum-256-bits-length-change-in-production!
# Set COOKIE_SECURE to true in production (requires HTTPS), false for local HTTP dev
COOKIE_SECURE=false

# Google OAuth2 / OpenID Connect Credentials
# Obtain from Google Cloud Console (APIs & Services > Credentials > OAuth 2.0 Client IDs)
# Authorized Redirect URI: http://localhost:8080/login/oauth2/code/google
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ------------------------------------------------------------------------------
# AI Provider: DEV Profile (Localhost / 100% Offline with Ollama)
# ------------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2:latest
OLLAMA_EMBED_MODEL=mxbai-embed-large:latest

# ------------------------------------------------------------------------------
# AI Provider: PROD Profile (Cloud Deployment with Groq - Ultra Fast & Free)
# ------------------------------------------------------------------------------
# Obtain free API key from https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_CHAT_MODEL=llama-3.1-8b-instant

# Optional OpenAI Embedding for PROD (leave blank to use the built-in free vectorizer)
# OPENAI_API_KEY=
